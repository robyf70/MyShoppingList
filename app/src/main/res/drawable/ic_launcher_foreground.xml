<?xml version="1.0" encoding="utf-8"?>
<!--
  Basket with a ticked list inside. Everything sits within the centred 72x72 safe
  zone (corners stay inside radius 36 of 54,54) so no mask shape crops it.
  Single colour throughout: this drawable doubles as the <monochrome> layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- handle -->
    <path
        android:pathData="M40,46 C40,30 68,30 68,46"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- basket, tapered so it does not read as a box -->
    <path
        android:pathData="M26,46 L82,46 L72,80 L36,80 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- two ticked rows; a third turns to mud at 48dp -->
    <path
        android:pathData="M33,59 L37,63 L44,55"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M50,59 L74,59"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M37,71 L41,75 L48,67"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54,71 L70,71"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
