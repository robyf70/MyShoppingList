# Copy to keystore.properties and fill in. That file is git-ignored — never commit
# it, and never commit the keystore it points at.
#
# Create the keystore first (it prompts for the passwords, so they stay out of your
# shell history):
#
#   keytool -genkeypair -v \
#       -keystore ~/keys/myshoppinglist-release.jks \
#       -alias myshoppinglist -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks outside the repository and back it up somewhere durable. Every
# future update of a published app must be signed with this same key; lose it and
# you cannot update the app, only publish a new one under a different id.

storeFile=/home/you/keys/myshoppinglist-release.jks
storePassword=
keyAlias=myshoppinglist
keyPassword=

# CI can supply these as environment variables instead, which take effect when
# keystore.properties is absent:
#   MSL_STORE_FILE  MSL_STORE_PASSWORD  MSL_KEY_ALIAS  MSL_KEY_PASSWORD
